// Monastery Management System — Prisma schema
// Source of truth for PostgreSQL (Supabase).
//
// This schema replaces the previous e-commerce (Citrine Juice Co.) schema.
// The RBAC / auth / session / OTP / notification / audit infrastructure was
// kept as-is (it's domain-agnostic and every new module builds on it).
// The catalog/cart/order/driver/coupon/invoice models were removed and
// replaced with Room / Booking / News models that match the guesthouse
// booking domain. No table that survived was renamed at the column level
// where existing code depended on it (e.g. User.email/passwordHash).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (whatever OS you develop on). The Docker image
  // is node:20-alpine (musl libc, OpenSSL 3) — without this explicit target,
  // Prisma only ships the engine for the machine `prisma generate` ran on,
  // and the query engine fails to load at container startup with an
  // "Unable to require libquery_engine..." / "Prisma Client could not
  // locate the Query Engine" error. This is one of the most common reasons
  // a Prisma+Docker app builds fine but crashes immediately at runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (pgbouncer) — used at runtime
  directUrl = env("DIRECT_URL")   // direct connection — used only by `prisma migrate`
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // super_admin | booking_manager | user
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. rooms.write, bookings.manage
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Users, auth, sessions
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  phone           String?   @unique
  email           String?   @unique
  passwordHash    String?   @map("password_hash")
  name            String?
  roleId          String?   @map("role_id")
  role            Role?     @relation(fields: [roleId], references: [id])
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isActive        Boolean   @default(true) @map("is_active")

  sessions        Session[]
  refreshTokens   RefreshToken[]
  otpCodes        OtpCode[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  bookings        Booking[]      @relation("BookingUser")
  managedBookings Booking[]      @relation("BookingManager")
  newsPosts       NewsPost[]

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo   String?   @map("device_info")
  ip           String?
  rememberMe   Boolean   @default(false) @map("remember_me")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash") // never store raw token
  deviceInfo  String?   @map("device_info")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier String    // email (phone/SMS not wired up)
  codeHash   String    @map("code_hash") // hashed, never store raw OTP
  purpose    String    // verify_email | login | reset_password | change_password
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([identifier, purpose])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Rooms — managed exclusively by Super Admin. No hardcoded/static rooms;
// every room is a real row created through the admin UI.
// ---------------------------------------------------------------------------

model Room {
  id           String        @id @default(uuid())
  number       String        @unique @map("number") // e.g. "101"
  type         String?       // free-text label set by Super Admin, e.g. "family", "dorm"
  capacity     Int           @map("capacity") // total beds in the room
  notes        String?
  isActive     Boolean       @default(true) @map("is_active")
  bookingRooms BookingRoom[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("rooms")
}

// ---------------------------------------------------------------------------
// Bookings — three types: individual | full_room | retreat
// ---------------------------------------------------------------------------

model Booking {
  id                 String        @id @default(uuid())
  code               String?       @unique // e.g. MON-2026-000125, assigned on approval
  type               String        // individual | full_room | retreat
  userId             String?       @map("user_id")
  user               User?         @relation("BookingUser", fields: [userId], references: [id])

  gender             String?       // male | female — required for individual & retreat
  churchName         String?       @map("church_name")
  contactName        String?       @map("contact_name") // group leader / responsible person
  phone              String
  address            String?
  governorate        String?
  notes              String?

  familySize         Int?          @map("family_size")  // full_room bookings
  groupSize          Int?          @map("group_size")   // retreat bookings
  roomsNeeded        Int?          @map("rooms_needed")  // computed for retreat bookings

  arrivalDate        DateTime      @map("arrival_date")
  departureDate      DateTime      @map("departure_date")

  status             String        @default("pending") // pending|approved|rejected|checked_in|completed|cancelled
  rejectionReason    String?       @map("rejection_reason")

  bookingRooms       BookingRoom[]

  managedById        String?       @map("managed_by_id")
  managedBy          User?         @relation("BookingManager", fields: [managedById], references: [id])
  approvedAt         DateTime?     @map("approved_at")

  qrCodeUrl          String?       @map("qr_code_url")

  checkedInAt        DateTime?     @map("checked_in_at")
  checkedOutAt       DateTime?     @map("checked_out_at")

  reminder24hSentAt  DateTime?     @map("reminder_24h_sent_at")
  reminder2hSentAt   DateTime?     @map("reminder_2h_sent_at")

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([arrivalDate, departureDate])
  @@map("bookings")
}

// Join table: which room(s) a booking occupies, and how many beds it uses
// in each one. A full_room booking usually has one row; a retreat booking
// may span several rooms.
model BookingRoom {
  id            String   @id @default(uuid())
  bookingId     String   @map("booking_id")
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId        String   @map("room_id")
  room          Room     @relation(fields: [roomId], references: [id])
  bedsAllocated Int      @map("beds_allocated")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([bookingId, roomId])
  @@index([roomId])
  @@map("booking_rooms")
}

// ---------------------------------------------------------------------------
// News — Super Admin only
// ---------------------------------------------------------------------------

model NewsPost {
  id        String      @id @default(uuid())
  title     String
  body      String?
  category  String      @default("news") // news|mass_schedule|conference|meeting|event
  isPinned  Boolean     @default(false) @map("is_pinned")
  isHidden  Boolean     @default(false) @map("is_hidden")
  authorId  String?     @map("author_id")
  author    User?       @relation(fields: [authorId], references: [id])
  media     NewsMedia[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("news_posts")
}

model NewsMedia {
  id        String   @id @default(uuid())
  newsId    String   @map("news_id")
  news      NewsPost @relation(fields: [newsId], references: [id], onDelete: Cascade)
  url       String
  type      String   // image | file
  fileName  String?  @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("news_media")
}

// ---------------------------------------------------------------------------
// Notifications, settings, audit
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  channel   String    @default("in_app") // in_app|email|sms|push
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. booking.approve, room.create
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
