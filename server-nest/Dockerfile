# --- Build stage ---
FROM node:20-alpine AS build
WORKDIR /app
# package-lock.json* only matches if the file exists, so this works whether
# or not a lockfile has been committed yet.
COPY package.json package-lock.json* ./
COPY prisma ./prisma
# Prefer `npm ci` (fast, exact, reproducible) whenever a real lockfile is
# present; otherwise resolve from package.json directly. Once you commit a
# lockfile generated by `npm install` on a machine with registry access,
# this automatically switches to `npm ci` with no Dockerfile change needed.
RUN if [ -f package-lock.json ]; then \
      echo "Using npm ci (lockfile found)"; npm ci; \
    else \
      echo "No package-lock.json found — falling back to npm install. Commit a lockfile for reproducible builds."; \
      npm install; \
    fi
COPY . .
RUN npx prisma generate
RUN npm run build

# --- Runtime stage ---
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN if [ -f package-lock.json ]; then \
      npm ci --omit=dev; \
    else \
      npm install --omit=dev; \
    fi
RUN npx prisma generate
COPY --from=build /app/dist ./dist

EXPOSE 4000
CMD ["npm","run","start:prod"]
